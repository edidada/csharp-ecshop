[Unit]
Description=EcShop ASP.NET Core API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecshop
Group=ecshop
WorkingDirectory=/opt/csharp-ecshop
EnvironmentFile=/etc/ecshop/ecshop.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
ExecStart=/usr/bin/dotnet /opt/csharp-ecshop/EcShop.Api.dll
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecshop /var/log/ecshop

[Install]
WantedBy=multi-user.target
